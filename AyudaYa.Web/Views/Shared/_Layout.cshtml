<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · AyudaYa</title>
    <link rel="icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/css/ayudaya.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
    <script src="~/js/base.js" asp-append-version="true"></script>
</head>
<body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="encabezado">
        <div class="contenedor">
            <a class="marca" asp-controller="@(User.Identity?.IsAuthenticated == true ? "Panel" : "Home")" asp-action="Index" aria-label="AyudaYa, ir al inicio">
                <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d="M20 2C12.3 2 6 8.1 6 15.7 6 26 20 38 20 38s14-12 14-22.3C34 8.1 27.7 2 20 2z" fill="#0F766E"/><path d="M20 23.5s-6.5-4-6.5-8.3a3.6 3.6 0 0 1 6.5-2.1 3.6 3.6 0 0 1 6.5 2.1c0 4.3-6.5 8.3-6.5 8.3z" fill="#fff"/></svg>
                <span class="marca-texto">Ayuda<em>Ya</em></span>
            </a>
            <button type="button" class="boton-menu" aria-expanded="false" aria-controls="nav-principal">
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> Menú
            </button>
            <vc:navegacion />
        </div>
    </header>
    <main id="contenido" class="@ViewData["ClaseMain"]" tabindex="-1">
        <div class="contenedor"><partial name="_Mensajes" /></div>
        @RenderBody()
    </main>
    <footer class="pie">
        <div class="contenedor">
            <p>AyudaYa · TFI UTN FRGP 2026 · Equipo 46 NexusTech</p>
            <p>Si hay riesgo de vida, llamá al <a href="tel:911">911</a>.</p>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
