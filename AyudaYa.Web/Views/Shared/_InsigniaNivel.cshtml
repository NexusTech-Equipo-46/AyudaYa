@model string
@{
    var nivel = Model is "alta" or "media" or "baja" or "sin_stock" or "no_ofrece" ? Model : "desconocido";
    var texto = nivel switch { "alta" => "Alta", "media" => "Media", "baja" => "Baja", "sin_stock" => "Sin stock", "no_ofrece" => "No ofrece", _ => "Sin informar" };
}
<span class="insignia nivel-@nivel">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        @if (nivel == "alta" || nivel == "media" || nivel == "baja")
        {
            <rect x="1" y="9" width="4" height="6" rx="1" fill="currentColor" />
            <rect x="6.5" y="5.5" width="3" height="9" rx="1" fill="@(nivel == "baja" ? "none" : "currentColor")" stroke="currentColor" />
            <rect x="11.5" y="1.5" width="3" height="13" rx="1" fill="@(nivel == "alta" ? "currentColor" : "none")" stroke="currentColor" />
        }
        else if (nivel == "sin_stock")
        {
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        }
        else
        {
            <path d="M4 8h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        }
    </svg>
    @texto
</span>
