<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · AyudaYa</title>
    <link rel="stylesheet" href="~/css/inicio.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
    <script>document.documentElement.classList.add("js");</script>
</head>
<body data-url-inicio="@Url.Action("Index", "Home")" data-url-centros="@Url.Action("Index", "Centros")" data-url-detalle-demo="@Url.Action("Ejemplo", "Centros")" data-url-login="@Url.Action(User.Identity?.IsAuthenticated == true ? "Perfil" : "Login", "Cuenta")" data-url-registro="@Url.Action(User.Identity?.IsAuthenticated == true ? "Perfil" : "Registro", "Cuenta")" data-url-pedir="@(User.Identity?.IsAuthenticated == true ? Url.Action("Nueva", "Solicitudes") : Url.Action("Login", "Cuenta", new { returnUrl = Url.Action("Nueva", "Solicitudes") }))">
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <div class="aviso-prototipo" role="note">@(ViewData["DatosFicticios"] is true ? "Prototipo navegable · Zona visitante · Datos ficticios" : "AyudaYa · Zona visitante")</div>
    <header class="encabezado">
        <div class="contenedor">
            <a class="marca" asp-controller="Home" asp-action="Index" aria-label="AyudaYa, ir al inicio">
                <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d="M20 2C12.3 2 6 8.1 6 15.7 6 26 20 38 20 38s14-12 14-22.3C34 8.1 27.7 2 20 2z" fill="#0F766E"/><path d="M20 23.5s-6.5-4-6.5-8.3a3.6 3.6 0 0 1 6.5-2.1 3.6 3.6 0 0 1 6.5 2.1c0 4.3-6.5 8.3-6.5 8.3z" fill="#fff"/></svg>
                <span class="marca-texto">Ayuda<em>Ya</em></span>
            </a>
            <button type="button" class="boton-menu" aria-expanded="false" aria-controls="nav-principal">
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> Menú
            </button>
            <nav id="nav-principal" class="nav-principal" aria-label="Principal">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li><a asp-controller="Centros" asp-action="Index" aria-current="@(ViewData["MapaActual"] is true ? "page" : null)">Mapa de centros</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li><a asp-controller="Cuenta" asp-action="Perfil">Mi perfil</a></li>
                        <li><form asp-controller="Cuenta" asp-action="Logout" method="post"><button class="boton" type="submit">Cerrar sesión</button></form></li>
                    }
                    else
                    {
                        <li><a asp-controller="Cuenta" asp-action="Login" aria-current="@(ViewData["LoginActual"] is true ? "page" : null)">Iniciar sesión</a></li>
                        <li><a class="boton" asp-controller="Cuenta" asp-action="Registro" aria-current="@(ViewData["RegistroActual"] is true ? "page" : null)">Crear cuenta</a></li>
                    }
                </ul>
            </nav>
        </div>
    </header>
    <main id="contenido" tabindex="-1">@RenderBody()</main>
    <footer class="pie"><div class="contenedor"><p>AyudaYa · TFI UTN FRGP 2026 · Equipo 46 NexusTech</p><p>Si hay riesgo de vida, llamá al <a href="tel:911">911</a>.</p></div></footer>
    @if (ViewData["UsaScriptsPrototipo"] is not true)
    {
        <script src="~/js/inicio.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
