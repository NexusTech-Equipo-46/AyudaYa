@model ErrorViewModel
@{
    ViewData["Title"] = Model.Titulo;
}
<div class="contenedor">
    <div class="no-encontrado">
        <h1>@Model.Titulo</h1>
        <p>@Model.Mensaje</p>
        @if (Model.ShowRequestId)
        {
            <p class="texto-suave">Código de seguimiento: <code>@Model.RequestId</code></p>
        }
        <div class="acciones" style="justify-content:center">
            <a class="boton" asp-controller="Home" asp-action="Index">Ir al inicio</a>
            <a class="boton boton-secundario" asp-controller="Centros" asp-action="Index">Ver centros de ayuda</a>
        </div>
    </div>
</div>
