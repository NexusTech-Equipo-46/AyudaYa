@model MapaCentrosViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Mapa de centros";
    var nombresRecursos = Model.TiposRecurso.ToDictionary(t => t.Codigo, t => t.Nombre);
    var datosTarjeta = new ViewDataDictionary(ViewData) { ["BotonMapa"] = true, ["NombresRecursos"] = nombresRecursos };
    var ciudades = Model.Centros.Select(c => c.Ciudad).Where(c => !string.IsNullOrEmpty(c)).Distinct().ToList();
}
@section Head {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css">
}
<div class="pagina-mapa">
    <div class="contenedor">
        <h1>Centros de ayuda@(ciudades.Count == 1 ? " en " + ciudades[0] : "")</h1>
        <p class="introduccion texto-suave">Solo se muestran centros verificados de organizaciones activas. La disponibilidad la cargan los propios centros: si se actualizó hace mucho, llamá antes de ir.</p>

        <details class="panel-filtros" id="panel-filtros" open>
            <summary>Filtros <span id="filtros-activos"></span></summary>
            <form class="filtros" id="filtros" role="search" aria-label="Filtrar centros">
                <div class="campo campo-busqueda">
                    <label for="f-buscar">Buscar por nombre o dirección</label>
                    <input type="search" id="f-buscar" name="q" autocomplete="off">
                </div>
                <div class="campo">
                    <label for="f-zona">Zona</label>
                    <select id="f-zona" name="zona">
                        <option value="">Todas las zonas</option>
                        @foreach (var zona in Model.Zonas)
                        {
                            <option value="@zona.Id">@zona.Nombre</option>
                        }
                    </select>
                </div>
                <div class="campo">
                    <label for="f-tipo">Tipo de centro</label>
                    <select id="f-tipo" name="tipo">
                        <option value="">Todos los tipos</option>
                        @foreach (var tipo in Model.TiposCentro)
                        {
                            <option value="@tipo.Codigo">@tipo.Nombre</option>
                        }
                    </select>
                </div>
                <div class="campo">
                    <label for="f-recurso">Recurso que necesitás</label>
                    <select id="f-recurso" name="recurso" aria-describedby="ayuda-recurso">
                        <option value="">Cualquier recurso</option>
                        @foreach (var tipo in Model.TiposRecurso)
                        {
                            <option value="@tipo.Codigo" selected="@(tipo.Codigo == Model.RecursoInicial)">@tipo.Nombre</option>
                        }
                    </select>
                </div>
                <div class="filtros-extra">
                    <label class="check"><input type="checkbox" id="f-abiertos" name="abiertos" value="1"> Ocultar centros cerrados temporalmente</label>
                    @if (Model.Necesidades.Count > 0)
                    {
                        <label class="check"><input type="checkbox" id="f-necesidades" name="necesidades" value="1"> Mostrar zonas con pedidos de ayuda</label>
                    }
                    <span id="ayuda-recurso" class="texto-suave">Con un recurso elegido, solo aparecen los centros que lo tienen disponible.</span>
                    <button type="reset" class="boton-texto">Limpiar filtros</button>
                </div>
            </form>
        </details>

        <div class="barra-resultados">
            <p id="cantidad" role="status" aria-live="polite">@Formato.Plural(Model.Centros.Count, "centro", "centros")</p>
            <div class="selector-vista" role="group" aria-label="Forma de ver los resultados">
                <button type="button" data-vista="lista" aria-pressed="true">Lista</button>
                <button type="button" data-vista="mapa" aria-pressed="false">Mapa</button>
            </div>
        </div>

        <div class="resultados" id="resultados" data-vista="lista">
            <div>
                <h2 class="visualmente-oculto">Lista de centros</h2>
                <ul class="lista-centros" id="lista-centros">
                    @foreach (var centro in Model.Centros)
                    {
                        <li data-centro="@centro.Id"><partial name="_TarjetaCentro" model="centro" view-data="datosTarjeta" /></li>
                    }
                </ul>
                <div class="tarjeta sin-resultados" id="sin-resultados" hidden>
                    <h3>No hay centros con esos filtros</h3>
                    <p>Probá con otra zona o quitá algún filtro.</p>
                    <button type="button" class="boton boton-secundario" id="limpiar-vacio">Limpiar filtros</button>
                </div>
                @if (Model.Centros.Count == 0)
                {
                    <div class="tarjeta sin-resultados">
                        <h3>Todavía no hay centros publicados</h3>
                        <p>Cuando una organización cargue un centro y un administrador lo apruebe, va a aparecer acá.</p>
                    </div>
                }
            </div>
            <section class="zona-mapa" aria-labelledby="titulo-mapa">
                <h2 id="titulo-mapa" class="visualmente-oculto">Mapa de centros</h2>
                <div id="mapa"></div>
                <p class="nota-mapa" id="nota-mapa">Con teclado: <kbd>Tab</kbd> recorre los marcadores y <kbd>Enter</kbd> abre la información del centro. La lista muestra lo mismo que el mapa.</p>
            </section>
        </div>

        <details class="tarjeta necesidades-zona">
            <summary>Pedidos de ayuda abiertos por zona</summary>
            <p class="texto-suave">Son cantidades aproximadas por zona: nunca se muestran direcciones ni ubicaciones exactas.</p>
            <p id="sin-pedidos-zona" role="status" hidden="@(Model.Necesidades.Count > 0)">No hay pedidos abiertos para mostrar.</p>
            <div class="tabla-scroll" id="tabla-pedidos-zona" tabindex="0" role="region" aria-label="Pedidos de ayuda abiertos por zona" hidden="@(Model.Necesidades.Count == 0)">
                <table class="tabla-recursos">
                    <thead><tr><th scope="col">Zona</th><th scope="col">Pedidos abiertos</th><th scope="col">Personas</th><th scope="col">Recursos más pedidos</th></tr></thead>
                    <tbody>
                        @foreach (var n in Model.Necesidades.OrderByDescending(n => n.SolicitudesAbiertas))
                        {
                            <tr data-zona="@n.ZonaId">
                                <th scope="row">@n.Zona</th>
                                <td>@n.SolicitudesAbiertas</td>
                                <td>@n.PersonasAfectadas</td>
                                <td>@string.Join(", ", n.Recursos.OrderByDescending(r => r.Personas).Take(3).Select(r => r.Nombre))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    </div>
</div>

@* Datos para el mapa. El serializador escapa los caracteres HTML, así que es seguro dentro del script. *@
<script id="datos-centros" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.DatosCentros, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
<script id="datos-necesidades" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.DatosNecesidades, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/mapa-comun.js" asp-append-version="true"></script>
    <script src="~/js/mapa-centros.js" asp-append-version="true"></script>
}
