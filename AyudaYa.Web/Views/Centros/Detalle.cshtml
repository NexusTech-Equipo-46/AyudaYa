@model DetalleCentroViewModel
@using System.Globalization
@{
    Layout = "_VisitanteLayout";
    var centro = Model.Centro;
    ViewData["Title"] = centro.Nombre;
    var ordenCatalogo = new[] { "agua", "alimentos", "abrigo", "higiene", "medicamentos", "alojamiento", "traslado", "mano_obra", "otros" };
    var recursos = Model.TiposRecurso
        .Where(t => t.Activo || centro.Recursos.ContainsKey(t.Codigo))
        .OrderBy(t => centro.Recursos.ContainsKey(t.Codigo) ? 0 : 1)
        .ThenBy(t => Array.IndexOf(ordenCatalogo, t.Codigo) is var indice && indice >= 0 ? indice : int.MaxValue)
        .ThenBy(t => t.Nombre)
        .ToList();
    var estado = centro.EstadoOperativo is "operativo" or "saturado" or "cerrado" ? centro.EstadoOperativo : "desconocido";
    var textoEstado = estado switch { "operativo" => "Abierto", "saturado" => "Saturado", "cerrado" => "Cerrado temporalmente", _ => "Sin informar" };
    var tipoOrganizacion = centro.OrganizacionTipo switch { "comunitaria" => "organización comunitaria", "institucional" => "organización institucional", _ => null };
    var tieneCoordenadas = centro.Latitud is double lat && double.IsFinite(lat) && lat is >= -90 and <= 90
        && centro.Longitud is double lon && double.IsFinite(lon) && lon is >= -180 and <= 180;
    var coordenadas = tieneCoordenadas ? $"{centro.Latitud!.Value.ToString(CultureInfo.InvariantCulture)},{centro.Longitud!.Value.ToString(CultureInfo.InvariantCulture)}" : null;
    var urlComoLlegar = tieneCoordenadas
        ? $"https://www.google.com/maps/dir/?api=1&destination={coordenadas}"
        : !string.IsNullOrWhiteSpace(centro.Direccion)
            ? $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(string.Join(", ", new[] { centro.Direccion, centro.Zona, centro.Ciudad }.Where(s => !string.IsNullOrWhiteSpace(s))))}"
            : null;
    var telefono = new string((centro.Telefono ?? "").Where(char.IsAsciiDigit).ToArray());
    if (telefono.Length > 0 && centro.Telefono!.TrimStart().StartsWith('+')) telefono = "+" + telefono;
    var dias = new[] { "", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo" };
    var actualizado = centro.RecursosActualizadoAt;
}
@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.css" crossorigin="">
}
<div class="contenedor" id="detalle-centro">
    <nav class="migas" aria-label="Estás en">
        <ol>
            <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li><a asp-controller="Centros" asp-action="Index">Mapa de centros</a></li>
            <li><a asp-action="Detalle" asp-route-id="@centro.Id" aria-current="page">@centro.Nombre</a></li>
        </ol>
    </nav>
    <div class="detalle-encabezado">
        <div>
            <h1>@centro.Nombre</h1>
            <p class="meta">@centro.TipoNombre · @centro.Zona, @centro.Ciudad</p>
            @if (!string.IsNullOrWhiteSpace(centro.OrganizacionNombre))
            {
                <p class="meta">@centro.OrganizacionNombre@if (tipoOrganizacion is not null) { <text> (@tipoOrganizacion)</text> }</p>
            }
        </div>
        <span class="insignia estado-@estado">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                @if (estado == "operativo") { <path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /> }
                else if (estado == "saturado") { <path d="M8 1.5L15 14H1z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 6v3.5" stroke="currentColor" stroke-width="1.8"/><circle cx="8" cy="11.8" r="1" fill="currentColor"/> }
                else { <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M6.3 5.5v5M9.7 5.5v5" stroke="currentColor" stroke-width="1.8"/> }
            </svg>
            <span class="visualmente-oculto">Estado: </span>@textoEstado
        </span>
    </div>
    <div class="detalle">
        <div>
            @if (estado == "cerrado" || estado == "saturado")
            {
                <div class="alerta @(estado == "cerrado" ? "alerta-peligro" : "alerta-advertencia")">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5L22.5 21h-21z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 9v5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="17.5" r="1.3" fill="currentColor"/></svg>
                    @if (estado == "cerrado") { <p><strong>Este centro está cerrado temporalmente.</strong> Buscá otro centro abierto en el mapa.</p> }
                    else { <p><strong>Este centro está saturado.</strong> Puede que no pueda recibir a más personas. Llamá antes de ir.</p> }
                </div>
            }
            @if (actualizado.HasValue && DateTime.UtcNow - actualizado.Value.ToUniversalTime() > TimeSpan.FromHours(24))
            {
                <div class="alerta alerta-advertencia">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5L22.5 21h-21z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 9v5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="17.5" r="1.3" fill="currentColor"/></svg>
                    <p><strong>La disponibilidad se actualizó <time class="fecha-relativa" datetime="@actualizado.Value.ToUniversalTime().ToString("O")">el @actualizado.Value.ToUniversalTime().ToString("dd/MM/yyyy HH:mm") UTC</time>.</strong> Puede no estar al día: confirmá por teléfono antes de ir.</p>
                </div>
            }
            <section class="tarjeta" aria-labelledby="titulo-recursos">
                <h2 id="titulo-recursos">Disponibilidad de recursos</h2>
                @if (recursos.Count == 0 || centro.Recursos.Count == 0)
                {
                    <p>Este centro no tiene recursos informados.</p>
                }
                else
                {
                    <table class="tabla-recursos">
                        <caption>
                            @if (actualizado.HasValue)
                            {
                                <text>Actualizada </text><time class="fecha-relativa" datetime="@actualizado.Value.ToUniversalTime().ToString("O")">@actualizado.Value.ToUniversalTime().ToString("dd/MM/yyyy HH:mm") UTC</time><text> (</text><time class="fecha-completa" datetime="@actualizado.Value.ToUniversalTime().ToString("O")">@actualizado.Value.ToUniversalTime().ToString("dd/MM/yyyy HH:mm") UTC</time><text>)</text>
                            }
                            else { <text>Fecha de actualización no informada</text> }
                        </caption>
                        <thead><tr><th scope="col">Recurso</th><th scope="col">Disponibilidad</th></tr></thead>
                        <tbody>
                            @foreach (var recurso in recursos)
                            {
                                <tr><th scope="row">@recurso.Nombre</th><td><partial name="_InsigniaNivel" model='@(centro.Recursos.GetValueOrDefault(recurso.Codigo, "no_ofrece"))' /></td></tr>
                            }
                        </tbody>
                    </table>
                    <h3 class="visualmente-oculto">Qué significa cada nivel</h3>
                    <ul class="referencias">
                        <li><partial name="_InsigniaNivel" model='@("alta")' /> hay suficiente</li>
                        <li><partial name="_InsigniaNivel" model='@("media")' /> queda una cantidad moderada</li>
                        <li><partial name="_InsigniaNivel" model='@("baja")' /> queda poco, conviene llamar antes</li>
                        <li><partial name="_InsigniaNivel" model='@("sin_stock")' /> lo ofrece, pero hoy no tiene</li>
                    </ul>
                }
            </section>
            @if (!string.IsNullOrWhiteSpace(centro.Descripcion))
            {
                <section class="tarjeta" aria-labelledby="titulo-descripcion"><h2 id="titulo-descripcion">Sobre este centro</h2><p>@centro.Descripcion</p></section>
            }
            @if (centro.Horarios.Count > 0)
            {
                <section class="tarjeta" aria-labelledby="titulo-horarios">
                    <h2 id="titulo-horarios">Horarios de atención</h2>
                    <ul>
                        @foreach (var horario in centro.Horarios)
                        {
                            <li>@(horario.DiaSemana is >= 1 and <= 7 ? dias[horario.DiaSemana] : "Día no informado"): @(horario.TodoElDia ? "24 horas" : !string.IsNullOrWhiteSpace(horario.Abre) && !string.IsNullOrWhiteSpace(horario.Cierra) ? $"{horario.Abre} a {horario.Cierra}" : "Horario no informado")@if (!string.IsNullOrWhiteSpace(horario.Notas)) { <text> · @horario.Notas</text> }</li>
                        }
                    </ul>
                </section>
            }
        </div>
        <div>
            <section class="tarjeta" aria-labelledby="titulo-contacto">
                <h2 id="titulo-contacto">Contacto y ubicación</h2>
                <dl class="datos-contacto">
                    <div><dt>Dirección</dt><dd>@(string.IsNullOrWhiteSpace(centro.Direccion) ? "No informada" : centro.Direccion)</dd></div>
                    <div><dt>Teléfono</dt><dd>@if (!string.IsNullOrEmpty(telefono)) { <a href="tel:@telefono">@centro.Telefono</a> } else { <text>No informado</text> }</dd></div>
                    @if (!string.IsNullOrWhiteSpace(centro.Email)) { <div><dt>Correo</dt><dd><a href="mailto:@centro.Email">@centro.Email</a></dd></div> }
                </dl>
                @if (tieneCoordenadas)
                {
                    <div id="mapa-centro" role="region" aria-label="Mapa con la ubicación de @centro.Nombre" data-latitud="@centro.Latitud!.Value.ToString(CultureInfo.InvariantCulture)" data-longitud="@centro.Longitud!.Value.ToString(CultureInfo.InvariantCulture)" data-nombre="@centro.Nombre" hidden></div>
                    <p id="mapa-no-disponible" class="texto-suave" style="margin-top:1rem">No se pudo cargar el mapa. Usá la dirección o “Cómo llegar”.</p>
                }
                else { <p class="texto-suave" style="margin-top:1rem">Este centro no cargó su ubicación en el mapa.</p> }
                @if (urlComoLlegar is not null)
                {
                    <a class="boton boton-secundario" href="@urlComoLlegar" target="_blank" rel="noopener noreferrer">Cómo llegar<span class="visualmente-oculto"> (se abre en otra pestaña)</span></a>
                }
            </section>
            <section class="tarjeta llamado" aria-labelledby="titulo-llamado">
                <h2 id="titulo-llamado">¿No encontrás lo que necesitás?</h2>
                <p>Con una cuenta podés pedir ayuda y un voluntario u organización de tu zona va a poder asistirte.</p>
                <div class="acciones">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="boton" asp-controller="Solicitudes" asp-action="Nueva">Pedir ayuda</a>
                    }
                    else
                    {
                        <a class="boton" asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@Url.Action("Nueva", "Solicitudes")">Pedir ayuda</a>
                    }
                    <a class="boton boton-secundario" asp-controller="Cuenta" asp-action="@(User.Identity?.IsAuthenticated == true ? "Perfil" : "Registro")">Quiero ser voluntario</a>
                </div>
            </section>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script src="~/js/centro-detalle.js" asp-append-version="true"></script>
}
