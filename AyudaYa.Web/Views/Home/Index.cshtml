@model InicioViewModel
@{
    Layout = null;
    var nombresRecursos = new Dictionary<string, string> {
        ["agua"] = "Agua", ["alimentos"] = "Alimentos", ["abrigo"] = "Abrigo",
        ["higiene"] = "Higiene", ["medicamentos"] = "Medicamentos",
        ["alojamiento"] = "Alojamiento", ["traslado"] = "Traslado"
    };
    var nombresNiveles = new Dictionary<string, string> {
        ["alta"] = "Alta", ["media"] = "Media", ["baja"] = "Baja",
        ["sin_stock"] = "Sin stock", ["no_ofrece"] = "No ofrece"
    };
}
<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AyudaYa · Encontrá ayuda cerca tuyo</title>
    <link rel="stylesheet" href="~/css/inicio.css" asp-append-version="true">
    <script>document.documentElement.classList.add("js");</script>
</head>
<body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <div class="aviso-prototipo" role="note">AyudaYa · Zona visitante</div>
    <header class="encabezado">
        <div class="contenedor">
            <a class="marca" asp-controller="Home" asp-action="Index" aria-label="AyudaYa, ir al inicio">
                <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d="M20 2C12.3 2 6 8.1 6 15.7 6 26 20 38 20 38s14-12 14-22.3C34 8.1 27.7 2 20 2z" fill="#0F766E"/><path d="M20 23.5s-6.5-4-6.5-8.3a3.6 3.6 0 0 1 6.5-2.1 3.6 3.6 0 0 1 6.5 2.1c0 4.3-6.5 8.3-6.5 8.3z" fill="#fff"/></svg>
                <span class="marca-texto">Ayuda<em>Ya</em></span>
            </a>
            <button type="button" class="boton-menu" aria-expanded="false" aria-controls="nav-principal">
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> Menú
            </button>
            <nav id="nav-principal" class="nav-principal" aria-label="Principal">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index" aria-current="page">Inicio</a></li>
                    <li><a asp-controller="Centros" asp-action="Index">Mapa de centros</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li><a asp-controller="Cuenta" asp-action="Perfil">Mi perfil</a></li>
                        <li><form asp-controller="Cuenta" asp-action="Logout" method="post"><button class="boton" type="submit">Cerrar sesión</button></form></li>
                    }
                    else
                    {
                        <li><a asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a></li>
                        <li><a class="boton" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a></li>
                    }
                </ul>
            </nav>
        </div>
    </header>
    <main id="contenido" tabindex="-1">
        <section class="portada" aria-labelledby="titulo-portada">
            <div class="contenedor">
                <div>
                    <h1 id="titulo-portada">Encontrá ayuda cerca tuyo en una emergencia</h1>
                    <p class="bajada">AyudaYa reúne en un solo lugar los refugios, comedores, salitas y puntos de donación de tu ciudad, con lo que tiene disponible cada uno.</p>
                    <div class="acciones">
                        <a class="boton" asp-controller="Centros" asp-action="Index">Ver centros de ayuda</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="boton boton-secundario" asp-controller="Solicitudes" asp-action="Nueva">Pedir ayuda</a>
                        }
                        else
                        {
                            <a class="boton boton-secundario" asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@Url.Action("Nueva", "Solicitudes")">Pedir ayuda</a>
                        }
                    </div>
                    <div class="necesidades">
                        <h2>¿Qué necesitás?</h2>
                        <ul>
                            @foreach (var recurso in new[] { "agua", "alimentos", "abrigo", "alojamiento", "medicamentos", "higiene" })
                            {
                                <li><a asp-controller="Centros" asp-action="Index" asp-route-recurso="@recurso">@nombresRecursos[recurso]</a></li>
                            }
                        </ul>
                    </div>
                </div>
                <aside class="tarjeta emergencia" aria-labelledby="titulo-emergencia">
                    <h2 id="titulo-emergencia">¿Hay riesgo de vida?</h2>
                    <p class="texto-suave">No esperes: llamá directamente a emergencias.</p>
                    <ul>
                        <li><a href="tel:911">911 <span>Emergencias</span></a></li>
                        <li><a href="tel:107">107 <span>SAME · Emergencias médicas</span></a></li>
                        <li><a href="tel:100">100 <span>Bomberos</span></a></li>
                    </ul>
                </aside>
            </div>
        </section>
        <section class="seccion" aria-labelledby="titulo-como">
            <div class="contenedor">
                <h2 id="titulo-como">Cómo funciona</h2>
                <ol class="pasos">
                    <li class="tarjeta"><h3>Buscá un centro</h3><p>Mirá en el mapa o en la lista qué centros están abiertos y qué recursos tienen. No hace falta registrarse.</p></li>
                    <li class="tarjeta"><h3>Pedí ayuda</h3><p>Con tu cuenta podés cargar una solicitud. Tu dirección y teléfono solo los ve quien te asista.</p></li>
                    <li class="tarjeta"><h3>Sumate a ayudar</h3><p>Anotate como voluntario o registrá tu organización para atender solicitudes de tu zona.</p></li>
                </ol>
            </div>
        </section>
        <section class="seccion" aria-labelledby="titulo-recientes">
            <div class="contenedor">
                <div class="encabezado-seccion"><h2 id="titulo-recientes">Actualizados recientemente</h2><a asp-controller="Centros" asp-action="Index">Ver todos los centros</a></div>
                @if (Model.CentrosNoDisponibles)
                {
                    <p>No pudimos cargar los centros recientes en este momento. Intentá nuevamente más tarde.</p>
                }
                else if (Model.CentrosRecientes.Count == 0)
                {
                    <p>Todavía no hay centros con disponibilidad actualizada para mostrar.</p>
                }
                else
                {
                    <ul class="grilla-centros" id="centros-recientes">
                        @foreach (var centro in Model.CentrosRecientes)
                        {
                            var estado = centro.EstadoOperativo == "saturado" ? "saturado" : centro.EstadoOperativo == "operativo" ? "operativo" : "desconocido";
                            <li><article class="tarjeta centro" aria-labelledby="titulo-@centro.Id">
                                <h3 id="titulo-@centro.Id"><a asp-controller="Centros" asp-action="Detalle" asp-route-id="@centro.Id">@centro.Nombre</a></h3>
                                <p class="meta">@centro.TipoNombre · @centro.Zona</p>
                                <p class="estado"><span class="insignia estado-@estado"><span aria-hidden="true">@(estado == "operativo" ? "✓" : estado == "saturado" ? "⚠" : "–")</span><span class="visualmente-oculto">Estado: </span>@(estado == "operativo" ? "Abierto" : estado == "saturado" ? "Saturado" : "Sin informar")</span></p>
                                <ul class="lista-recursos" aria-label="Recursos que ofrece">
                                    @foreach (var recurso in centro.Recursos)
                                    {
                                        var nivel = nombresNiveles.ContainsKey(recurso.Value) ? recurso.Value : "desconocido";
                                        var nombre = nombresRecursos.GetValueOrDefault(recurso.Key, recurso.Key.Replace('_', ' '));
                                        <li><span class="insignia nivel-@nivel"><span aria-hidden="true">@(nivel == "alta" ? "▮▮▮" : nivel == "media" ? "▮▮▯" : nivel == "baja" ? "▮▯▯" : nivel == "sin_stock" ? "×" : "–")</span>@nombre <span aria-hidden="true">·</span><span class="visualmente-oculto">: disponibilidad</span> @nombresNiveles.GetValueOrDefault(nivel, "Sin informar")</span></li>
                                    }
                                </ul>
                                <div class="pie-centro"><span>Disponibilidad actualizada <time datetime="@centro.RecursosActualizadoAt!.Value.ToString("O")">@centro.RecursosActualizadoAt.Value.ToString("dd/MM/yyyy HH:mm") UTC</time></span></div>
                            </article></li>
                        }
                    </ul>
                }
            </div>
        </section>
    </main>
    <footer class="pie"><div class="contenedor"><p>AyudaYa · TFI UTN FRGP 2026 · Equipo 46 NexusTech</p><p>Si hay riesgo de vida, llamá al <a href="tel:911">911</a>.</p></div></footer>
    <script src="~/js/inicio.js" asp-append-version="true"></script>
</body>
</html>
