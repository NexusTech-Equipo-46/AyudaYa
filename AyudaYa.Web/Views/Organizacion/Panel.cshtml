@model PanelOrganizacionViewModel
@using AyudaYa.Web.Models.Organizacion
@{
    var org = Model.Panel.Organizacion;
    ViewData["Title"] = "Panel de la organización";
    ViewData["ClaseMain"] = "pagina-usuario";
    ViewData["Seccion"] = "panel";
    var datosTarjeta = new ViewDataDictionary(ViewData) { ["Controlador"] = "Organizacion", ["OrganizacionId"] = org.Id };
    var pendientes = Model.Panel.Centros.Where(c => c.EstadoVerificacion == "pendiente").ToList();
    var rechazados = Model.Panel.Centros.Where(c => c.EstadoVerificacion == "rechazado").ToList();
}
<div class="contenedor">
    <div class="cabecera-pagina">
        <div>
            <h1>@org.Nombre</h1>
            <p class="texto-suave">@Textos.TipoOrganizacion(org.Tipo) · @org.CiudadNombre</p>
        </div>
        @if (Model.Contexto.EstaActiva)
        {
            <a class="boton" asp-action="Solicitudes" asp-route-org="@org.Id">Buscar solicitudes para tomar</a>
        }
    </div>

    <partial name="_SubnavOrganizacion" model="Model.Contexto" view-data="ViewData" />

    @if (org.Estado == "rechazada" || org.Estado == "suspendida")
    {
        <div class="alerta alerta-peligro" style="margin-bottom:.75rem">@Iconos.AlertaPeligro<p><strong>Motivo:</strong> @org.MotivoEstado</p></div>
    }
    @if (pendientes.Count > 0)
    {
        <div class="alerta alerta-info" style="margin-bottom:.75rem">@Iconos.AlertaInfo<p><strong>@Formato.Plural(pendientes.Count, "centro espera", "centros esperan") aprobación.</strong> Hasta que un administrador lo apruebe, no aparece en el mapa público.</p></div>
    }
    @if (rechazados.Count > 0)
    {
        <div class="alerta alerta-peligro" style="margin-bottom:.75rem">@Iconos.AlertaPeligro<p><strong>@Formato.Plural(rechazados.Count, "centro fue rechazado", "centros fueron rechazados").</strong> Revisen el motivo en <a asp-action="Centros" asp-route-org="@org.Id">Centros</a>.</p></div>
    }

    <div class="panel">
        <div>
            <section aria-labelledby="titulo-activas">
                <div class="encabezado-seccion">
                    <h2 id="titulo-activas">Asignaciones activas</h2>
                    <a asp-action="Asignaciones" asp-route-org="@org.Id">Ver todas</a>
                </div>
                @if (Model.Activas.Count > 0)
                {
                    <ul class="lista-tarjetas">
                        @foreach (var asignacion in Model.Activas)
                        {
                            <li><partial name="_TarjetaAsignacion" model="asignacion" view-data="datosTarjeta" /></li>
                        }
                    </ul>
                }
                else
                {
                    <div class="tarjeta estado-vacio">
                        <h3>No tienen asignaciones activas</h3>
                        <p>Cuando alguien de la organización tome una solicitud, la van a ver acá para seguirla hasta el final.</p>
                        @if (Model.Contexto.EstaActiva)
                        {
                            <div class="acciones"><a class="boton" asp-action="Solicitudes" asp-route-org="@org.Id">Buscar solicitudes para tomar</a></div>
                        }
                    </div>
                }
            </section>
        </div>
        <div>
            <section class="tarjeta" aria-labelledby="titulo-resumen-panel">
                <h2 id="titulo-resumen-panel">Resumen</h2>
                <dl class="resumen">
                    <div><dt>Asignaciones activas</dt><dd>@Model.Panel.AsignacionesActivas</dd></div>
                    <div><dt>Por confirmar</dt><dd>@Model.Panel.AsignacionesCompletadas</dd></div>
                    <div><dt>Centros aprobados</dt><dd>@Model.Panel.Centros.Count(c => c.EstadoVerificacion == "aprobado")</dd></div>
                    <div><dt>Miembros activos</dt><dd>@Model.Panel.MiembrosActivos</dd></div>
                </dl>
            </section>
            <section class="tarjeta" aria-labelledby="titulo-centros-panel">
                <div class="encabezado-seccion">
                    <h2 id="titulo-centros-panel">Centros</h2>
                    <a asp-action="Centros" asp-route-org="@org.Id">Administrar</a>
                </div>
                @if (Model.Panel.Centros.Count == 0)
                {
                    <p class="texto-suave">Todavía no cargaron ningún centro.</p>
                }
                else
                {
                    <ul class="lista-simple" style="list-style:none;padding:0">
                        @foreach (var centro in Model.Panel.Centros)
                        {
                            <li style="margin-bottom:.75rem"><a asp-action="Recursos" asp-route-id="@centro.Id"><strong>@centro.Nombre</strong></a><br /><partial name="_InsigniaVerificacion" model="centro.EstadoVerificacion" /></li>
                        }
                    </ul>
                }
            </section>
            <aside class="tarjeta emergencia" aria-labelledby="titulo-emergencia">
                <h2 id="titulo-emergencia">¿Hay riesgo de vida?</h2>
                <p class="texto-suave">No esperen una respuesta de la app: llamen directamente.</p>
                <ul>
                    <li><a href="tel:911">911 <span>Emergencias</span></a></li>
                    <li><a href="tel:107">107 <span>SAME · Emergencias médicas</span></a></li>
                </ul>
            </aside>
        </div>
    </div>
</div>
