@model CentrosOrganizacionViewModel
@using AyudaYa.Web.Models.Organizacion
@{
    ViewData["Title"] = "Centros";
    ViewData["ClaseMain"] = "pagina-usuario";
    ViewData["Seccion"] = "centros";
}
<div class="contenedor">
    <div class="cabecera-pagina">
        <div>
            <h1>Centros</h1>
            <p class="texto-suave">Los lugares donde la organización ofrece o recibe ayuda. Un administrador tiene que aprobar cada centro antes de que aparezca en el mapa.</p>
        </div>
        @if (Model.Contexto.EsResponsable && Model.Contexto.Estado is "pendiente" or "activa")
        {
            <a class="boton" asp-action="NuevoCentro" asp-route-org="@Model.Contexto.OrganizacionId">Nuevo centro</a>
        }
    </div>
    <partial name="_SubnavOrganizacion" model="Model.Contexto" view-data="ViewData" />

    @if (Model.Centros.Count == 0)
    {
        <div class="tarjeta estado-vacio">
            <h3>Todavía no cargaron centros</h3>
            <p>Un centro puede ser un refugio, un comedor, una salita o un punto de donación.</p>
        </div>
    }
    else
    {
        <ul class="grilla-org">
            @foreach (var centro in Model.Centros)
            {
                var aprobado = centro.EstadoVerificacion == "aprobado";
                <li>
                    <article class="tarjeta centro-org" aria-labelledby="titulo-@centro.Id">
                        <h3 id="titulo-@centro.Id">@centro.Nombre</h3>
                        <p class="meta">@centro.TipoNombre · @centro.ZonaNombre</p>
                        <p class="meta">@centro.Direccion</p>
                        <p class="meta"><strong>Horario:</strong> @Formato.ResumenHorario(centro.Horarios)</p>
                        <div class="insignias">
                            <partial name="_InsigniaVerificacion" model="centro.EstadoVerificacion" />
                            @if (aprobado)
                            {
                                <span class="insignia estado-@centro.EstadoOperativo">@Iconos.EstadoOperativo(centro.EstadoOperativo)<span class="visualmente-oculto">Estado: </span>@Textos.EstadoOperativo(centro.EstadoOperativo)</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(centro.MotivoEstado))
                        {
                            <div class="alerta alerta-peligro">@Iconos.AlertaPeligro<p><strong>Motivo:</strong> @centro.MotivoEstado</p></div>
                        }
                        @if (centro.EstadoVerificacion == "pendiente")
                        {
                            <div class="alerta alerta-info">@Iconos.AlertaInfo<p>Un administrador lo está revisando. Todavía no aparece en el mapa.</p></div>
                        }
                        <div class="acciones">
                            <a class="boton boton-secundario" asp-action="Recursos" asp-route-id="@centro.Id">Recursos<span class="visualmente-oculto"> de @centro.Nombre</span></a>
                            @if (Model.Contexto.EsResponsable)
                            {
                                <a class="boton boton-secundario" asp-action="EditarCentro" asp-route-id="@centro.Id">Editar<span class="visualmente-oculto"> @centro.Nombre</span></a>
                            }
                            @if (aprobado && Model.Contexto.EstaActiva)
                            {
                                <a class="boton boton-secundario" asp-controller="Centros" asp-action="Detalle" asp-route-id="@centro.Id">Ver como visitante<span class="visualmente-oculto">: @centro.Nombre</span></a>
                            }
                        </div>
                    </article>
                </li>
            }
        </ul>
    }
</div>
