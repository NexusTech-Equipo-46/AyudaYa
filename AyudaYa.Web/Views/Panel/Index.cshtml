@model PanelViewModel
@{
    ViewData["Title"] = "Mi panel";
    ViewData["ClaseMain"] = "pagina-usuario";
}
<div class="contenedor">
    <div class="cabecera-pagina">
        <div>
            <h1>Hola, @Model.PrimerNombre</h1>
            <p class="texto-suave">Desde acá seguís tus pedidos de ayuda y tu participación como voluntario u organización.</p>
        </div>
        <a class="boton" asp-controller="Solicitudes" asp-action="Nueva">Pedir ayuda</a>
    </div>

    @if (!Model.EmailConfirmado)
    {
        <div class="alerta alerta-advertencia" role="status" style="margin-bottom:1.25rem">
            @Iconos.AlertaPeligro
            <p><strong>Falta confirmar tu correo.</strong> Hasta entonces no podés pedir ayuda, sumarte como voluntario ni registrar una organización. Revisá tu bandeja o <a asp-controller="Cuenta" asp-action="Perfil">pedí otro correo desde tu perfil</a>.</p>
        </div>
    }

    <div class="panel">
        <div>
            <section aria-labelledby="titulo-abiertas">
                <div class="encabezado-seccion">
                    <h2 id="titulo-abiertas">Solicitudes abiertas</h2>
                    <a asp-controller="Solicitudes" asp-action="Index">Ver todas mis solicitudes</a>
                </div>
                @if (Model.Abiertas.Count > 0)
                {
                    <ul class="lista-solicitudes">
                        @foreach (var solicitud in Model.Abiertas)
                        {
                            <li><partial name="_TarjetaSolicitud" model="solicitud" /></li>
                        }
                    </ul>
                }
                else
                {
                    <div class="tarjeta estado-vacio">
                        <h3>No tenés solicitudes abiertas</h3>
                        <p>Si necesitás agua, alimentos, abrigo u otra ayuda, cargá un pedido y alguien de tu zona lo va a tomar.</p>
                        <div class="acciones"><a class="boton" asp-controller="Solicitudes" asp-action="Nueva">Pedir ayuda</a></div>
                    </div>
                }
            </section>
        </div>
        <div>
            <section class="tarjeta" aria-labelledby="titulo-resumen-panel">
                <h2 id="titulo-resumen-panel">Tu actividad</h2>
                <dl class="resumen">
                    <div><dt>Abiertas</dt><dd>@Model.CantidadAbiertas</dd></div>
                    <div><dt>Resueltas</dt><dd>@Model.CantidadResueltas</dd></div>
                </dl>
            </section>

            <section class="tarjeta llamado" aria-labelledby="titulo-voluntario">
                <h2 id="titulo-voluntario">Voluntariado</h2>
                @if (Model.EsVoluntario)
                {
                    <p>Ya sos voluntario/a. Mirá las solicitudes que podés tomar y seguí tus asignaciones.</p>
                    <div class="acciones"><a class="boton" asp-controller="Voluntario" asp-action="Panel">Ir a mi panel de voluntario</a></div>
                }
                else
                {
                    <p>Todavía no sos voluntario/a. Sumate para atender solicitudes de tu zona: vos elegís cuáles tomar.</p>
                    <div class="acciones"><a class="boton boton-secundario" asp-controller="Voluntariado" asp-action="Index">Quiero ser voluntario</a></div>
                }
            </section>

            <section class="tarjeta" aria-labelledby="titulo-org">
                <h2 id="titulo-org">Organizaciones</h2>
                @if (Model.Organizaciones.Count > 0)
                {
                    <ul class="lista-simple">
                        @foreach (var organizacion in Model.Organizaciones)
                        {
                            <li><a asp-controller="Organizacion" asp-action="Panel" asp-route-org="@organizacion.OrganizacionId">@organizacion.OrganizacionNombre</a> · @Textos.Rol(organizacion.Rol)</li>
                        }
                    </ul>
                }
                else
                {
                    <p>Si representás a una organización, registrala para publicar centros y tomar solicitudes.</p>
                    <div class="acciones"><a class="boton boton-secundario" asp-controller="Organizacion" asp-action="Registrar">Registrar una organización</a></div>
                }
            </section>

            <aside class="tarjeta emergencia" aria-labelledby="titulo-emergencia">
                <h2 id="titulo-emergencia">¿Hay riesgo de vida?</h2>
                <p class="texto-suave">No esperes una respuesta de la app: llamá directamente.</p>
                <ul>
                    <li><a href="tel:911">911 <span>Emergencias</span></a></li>
                    <li><a href="tel:107">107 <span>SAME · Emergencias médicas</span></a></li>
                </ul>
            </aside>
        </div>
    </div>
</div>
