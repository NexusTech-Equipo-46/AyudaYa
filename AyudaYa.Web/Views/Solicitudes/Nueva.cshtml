@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Nueva solicitud";
    ViewData["NuevaSolicitudActual"] = true;
    ViewData["DatosFicticios"] = true;
}
<div class="contenedor">
            <nav class="migas" aria-label="Estás en">
                <ol>
                    <li><a asp-controller="Panel" asp-action="Index">Panel</a></li>
                    <li><a asp-controller="Solicitudes" asp-action="Nueva" aria-current="page">Nueva solicitud</a></li>
                </ol>
            </nav>

            <div class="formulario-solicitud" id="contenedor-nueva-solicitud">
                <h1>Pedir ayuda</h1>
                <p class="texto-suave">Contanos qué necesitás. Un voluntario o una organización de tu zona va a tomar tu pedido.</p>
                <div class="alerta alerta-info" role="note" style="margin-bottom:1.5rem">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 11v6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="7.5" r="1.3" fill="currentColor"/></svg>
                    <p><strong>Esta es una demostración.</strong> Usá datos ficticios: el formulario no envía ni guarda pedidos de ayuda reales.</p>
                </div>

                <div class="alerta alerta-advertencia" style="margin-bottom:1.5rem">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5L22.5 21h-21z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 9v5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="17.5" r="1.3" fill="currentColor"/></svg>
                    <p><strong>Si hay riesgo de vida, llamá al <a href="tel:911">911</a>.</strong> AyudaYa no reemplaza a los servicios de emergencia.</p>
                </div>

                <div class="alerta alerta-peligro resumen-errores" id="resumen-errores" tabindex="-1" aria-labelledby="titulo-resumen" hidden></div>

                <form id="form-solicitud" novalidate onsubmit="return false;">
                    <section class="tarjeta" aria-labelledby="t-situacion">
                        <h2 id="t-situacion">1. Tu situación</h2>

                        <div class="campo">
                            <label for="zona">Zona donde estás</label>
                            <span class="ayuda" id="ayuda-zona">Ciudad: <span id="nombre-ciudad">Tigre</span></span>
                            <select id="zona" name="zona" required aria-describedby="ayuda-zona error-zona">
                                <option value="">Elegí una zona</option>
                            </select>
                            <p class="error-campo" id="error-zona"></p>
                        </div>

                        <fieldset class="grupo" aria-describedby="ayuda-urgencia">
                            <legend>Urgencia</legend>
                            <span class="ayuda" id="ayuda-urgencia">Marcá “Crítica” solo si la situación no puede esperar. Se atienden primero.</span>
                            <div class="opciones-radio">
                                <label class="opcion">
                                    <input type="radio" name="urgencia" value="normal" checked>
                                    <span><strong>Normal</strong><small>Necesito ayuda, pero puedo esperar unas horas.</small></span>
                                </label>
                                <label class="opcion">
                                    <input type="radio" name="urgencia" value="critica">
                                    <span><strong>Crítica</strong><small>Es grave o no puede esperar.</small></span>
                                </label>
                            </div>
                        </fieldset>

                        <div class="campo">
                            <label for="personas">Personas afectadas</label>
                            <span class="ayuda" id="ayuda-personas">Contate a vos también.</span>
                            <input type="number" id="personas" name="personas" min="1" step="1" inputmode="numeric" required aria-describedby="ayuda-personas error-personas">
                            <p class="error-campo" id="error-personas"></p>
                        </div>
                    </section>

                    <section class="tarjeta" aria-labelledby="t-recursos">
                        <h2 id="t-recursos">2. Qué necesitás</h2>
                        <fieldset class="grupo" id="recursos-grupo" tabindex="-1" aria-describedby="ayuda-recursos error-recursos-grupo">
                            <legend class="visualmente-oculto">Recursos que necesitás</legend>
                            <span class="ayuda" id="ayuda-recursos">Elegí uno o más. Para cada uno, indicá cuántas personas lo necesitan.</span>
                            <div class="recursos-lista" id="recursos-lista"></div>
                            <p class="error-campo" id="error-recursos-grupo"></p>
                        </fieldset>

                        <div class="campo">
                            <label for="descripcion">Descripción <span class="opcional">(opcional)</span></label>
                            <span class="ayuda" id="ayuda-descripcion">Otros usuarios con cuenta pueden leer esto. No escribas tu dirección ni tu teléfono: van en el siguiente paso.</span>
                            <textarea id="descripcion" name="descripcion" rows="4" maxlength="500" aria-describedby="ayuda-descripcion error-descripcion"></textarea>
                            <p class="error-campo" id="error-descripcion"></p>
                        </div>
                    </section>

                    <section class="tarjeta" aria-labelledby="t-contacto">
                        <h2 id="t-contacto">3. Cómo ubicarte</h2>
                        <p class="nota-privada">
                            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5.2 7V5a2.8 2.8 0 0 1 5.6 0v2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                            <span>Tu dirección y teléfono solo los ven quienes te asistan y el equipo administrador. No se muestran en listados ni en el mapa.</span>
                        </p>

                        <div class="campo">
                            <label for="direccion">Dirección exacta</label>
                            <span class="ayuda" id="ayuda-direccion">Calle, número y referencias para encontrarte.</span>
                            <input type="text" id="direccion" name="direccion" autocomplete="street-address" maxlength="200" required aria-describedby="ayuda-direccion error-direccion">
                            <p class="error-campo" id="error-direccion"></p>
                        </div>

                        <div class="campo">
                            <label for="telefono">Teléfono de contacto</label>
                            <span class="ayuda" id="ayuda-telefono">Con característica, por ejemplo 011 5555-0123.</span>
                            <input type="tel" id="telefono" name="telefono" autocomplete="tel" inputmode="tel" maxlength="20" required aria-describedby="ayuda-telefono error-telefono">
                            <p class="error-campo" id="error-telefono"></p>
                        </div>
                    </section>

                    <p class="texto-suave" role="note">Esta es una demostración: no se enviará ningún pedido de ayuda.</p>
                    <div class="acciones">
                        <button type="submit" class="boton">Enviar solicitud</button>
                        <a class="boton boton-secundario" asp-controller="Panel" asp-action="Index">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
@section Scripts {
    <script src="~/js/demo/datos.js" asp-append-version="true"></script>
    <script src="~/js/demo/datos-usuario.js" asp-append-version="true"></script>
    <script src="~/js/demo/comun-usuario.js" asp-append-version="true"></script>
    <script src="~/js/demo/nueva-solicitud.js" asp-append-version="true"></script>
}
