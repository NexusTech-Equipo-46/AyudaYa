@model AyudaYa.Web.Models.Solicitudes.NuevaSolicitudViewModel
@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Nueva solicitud";
    ViewData["NuevaSolicitudActual"] = true;
}

<div class="contenedor">
    <nav class="migas" aria-label="Estás en">
        <ol>
            <li><a asp-controller="Panel" asp-action="Index">Panel</a></li>
            <li><a asp-controller="Solicitudes" asp-action="Nueva" aria-current="page">Nueva solicitud</a></li>
        </ol>
    </nav>
    <div class="formulario-solicitud" id="contenedor-nueva-solicitud">
        <h1>Pedir ayuda</h1>
        <p class="texto-suave">Contanos qué necesitás.</p>
        <div class="alerta alerta-advertencia" role="note">
            <p><strong>Si hay riesgo de vida, llamá al <a href="tel:911">911</a>.</strong> AyudaYa no reemplaza a los servicios de emergencia.</p>
        </div>

        
@if (Model.Zonas.Count == 0 || Model.NombresRecursos.Count == 0)
        {
            <div class="alerta alerta-advertencia" role="alert">
                Por ahora no hay zonas o recursos disponibles para crear una solicitud.
            </div>
        }
        else
        {
            <form asp-controller="Solicitudes" asp-action="Nueva" method="post">
                <div asp-validation-summary="All" class="alerta alerta-peligro" role="alert"></div>
                <section class="tarjeta" aria-labelledby="t-situacion">
                    <h2 id="t-situacion">1. Tu situación</h2>
                    <div class="campo">
                        <label asp-for="ZonaId">Ciudad y zona</label>
                        <select asp-for="ZonaId" required>
                            <option value="">Elegí una zona</option>
                            
@foreach (var zona in Model.Zonas)
                            {
                                <option value="@zona.Id">@zona.Nombre</option>
                            }

                        </select>
                    </div>
                    <fieldset class="grupo">
                        <legend>Urgencia</legend>
                        <div class="opciones-radio">
                            <label class="opcion"><input asp-for="Urgencia" type="radio" value="normal"> Normal</label>
                            <label class="opcion"><input asp-for="Urgencia" type="radio" value="critica"> Crítica</label>
                        </div>
                    </fieldset>
                    <div class="campo">
                        <label asp-for="PersonasAfectadas">Personas afectadas</label>
                        <span class="ayuda">Contate a vos también.</span>
                        <input asp-for="PersonasAfectadas" type="number" min="1" step="1" required>
                    </div>
                </section>
                <section class="tarjeta" aria-labelledby="t-recursos">
                    <h2 id="t-recursos">2. Qué necesitás</h2>
                    <p class="ayuda">Elegí uno o más recursos y, para cada uno, indicá cuántas personas lo necesitan.</p>
                    <div class="recursos-lista">
                        @for (var i = 0; i < Model.Recursos.Count; i++)
                        {
                            var nombre = Model.NombresRecursos.TryGetValue(Model.Recursos[i].TipoRecursoId, out var etiqueta)
                                ? etiqueta : "Recurso no disponible";
                            <div class="recurso-opcion">
                                <input asp-for="Recursos[i].TipoRecursoId" type="hidden">
                                <label class="check">
                                    <input asp-for="Recursos[i].Seleccionado"> Pedir @nombre
                                </label>
                                <div class="recurso-datos">
                                    <div class="campo">
                                        <label asp-for="Recursos[i].Personas">Personas que necesitan @nombre</label>
                                        <input asp-for="Recursos[i].Personas" type="number" min="1" step="1">
                                    </div>
                                    <div class="campo">
                                        <label asp-for="Recursos[i].Detalle">Detalle de @nombre (opcional)</label>
                                        <input asp-for="Recursos[i].Detalle" maxlength="200">
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="campo">
                        <label asp-for="Descripcion">Descripción (opcional)</label>
                        <span class="ayuda">No escribas acá tu dirección ni tu teléfono.</span>
                        <textarea asp-for="Descripcion" rows="4" maxlength="500"></textarea>
                    </div>
                </section>
                <section class="tarjeta" aria-labelledby="t-contacto">
                    <h2 id="t-contacto">3. Cómo ubicarte</h2>
                    <p class="nota-privada">La dirección y el teléfono son datos privados.</p>
                    <div class="campo">
                        <label asp-for="Direccion">Dirección exacta</label>
                        <input asp-for="Direccion" autocomplete="street-address" maxlength="200" required>
                    </div>
                    <div class="campo">
                        <label asp-for="Telefono">Teléfono de contacto</label>
                        <input asp-for="Telefono" type="tel" autocomplete="tel" maxlength="20" required>
                    </div>
                    <p class="ayuda">Para esta prueba local, ingresá las coordenadas manualmente.</p>
                    <div class="campo">
                        <label asp-for="Latitud">Latitud</label>
                        <input asp-for="Latitud" inputmode="decimal" required>
                    </div>
                    <div class="campo">
                        <label asp-for="Longitud">Longitud</label>
                        <input asp-for="Longitud" inputmode="decimal" required>
                    </div>
                </section>
                <div class="acciones">
                    <button type="submit" class="boton">Enviar solicitud</button>
                    <a class="boton boton-secundario" asp-controller="Panel" asp-action="Index">Cancelar</a>
                </div>
            </form>
        }

    </div>
</div>