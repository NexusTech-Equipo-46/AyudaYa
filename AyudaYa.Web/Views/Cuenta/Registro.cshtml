@model AyudaYa.Web.Models.Cuenta.RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<h1>Crear cuenta</h1>
<p class="text-muted">La cuenta se usa para publicar y gestionar solicitudes de ayuda.</p>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Registro" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" autocomplete="name" />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
                <div class="form-text">Se guarda en minúsculas y no distingue mayúsculas.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmarPassword" class="form-label"></label>
                <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Dni" class="form-label"></label>
                <input asp-for="Dni" class="form-control" inputmode="numeric" />
                <span asp-validation-for="Dni" class="text-danger"></span>
                <div class="form-text">Opcional. Se guarda en una tabla privada.</div>
            </div>

            <button type="submit" class="btn btn-primary">Crear cuenta</button>
            <a asp-action="Login" class="btn btn-link">Ya tengo cuenta</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
