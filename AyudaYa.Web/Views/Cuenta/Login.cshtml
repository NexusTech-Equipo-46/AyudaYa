@model AyudaYa.Web.Models.Cuenta.LoginViewModel
@{
    Layout = "_VisitanteLayout";
    ViewData["Title"] = "Iniciar sesión";
    ViewData["LoginActual"] = true;
    var errores = ViewData.ModelState
        .Where(entrada => entrada.Value is not null)
        .SelectMany(entrada => entrada.Value!.Errors.Select(error => (Campo: entrada.Key, Mensaje: error.ErrorMessage)))
        .ToList();
    var errorEmail = ViewData.ModelState.TryGetValue(nameof(Model.Email), out var estadoEmail) ? estadoEmail.Errors.FirstOrDefault()?.ErrorMessage : null;
    var errorPassword = ViewData.ModelState.TryGetValue(nameof(Model.Password), out var estadoPassword) ? estadoPassword.Errors.FirstOrDefault()?.ErrorMessage : null;
}
<div class="pagina-cuenta">
    <div class="contenedor">
        <div class="tarjeta" id="tarjeta-login">
            <h1>Iniciar sesión</h1>
            <div class="alerta alerta-peligro resumen-errores" id="resumen-errores" tabindex="-1" aria-labelledby="titulo-resumen" @(errores.Count == 0 ? "hidden" : null)>
                @if (errores.Count > 0)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5L22.5 21h-21z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 9v5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="17.5" r="1.3" fill="currentColor"/></svg>
                    <div><h2 id="titulo-resumen">@(errores.Count == 1 ? "Hay 1 dato para corregir" : $"Hay {errores.Count} datos para corregir")</h2>
                        <ul>
                            @foreach (var error in errores)
                            {
                                var idCampo = error.Campo == nameof(Model.Email) ? "email" : error.Campo == nameof(Model.Password) ? "contrasena" : null;
                                <li>@if (idCampo is not null) { <a href="#@idCampo">@error.Mensaje</a> } else { @error.Mensaje }</li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <form id="form-login" asp-action="Login" method="post" novalidate>
                <input asp-for="ReturnUrl" type="hidden" />
                <div class="campo">
                    <label for="email">Correo electrónico</label>
                    <input asp-for="Email" type="email" id="email" autocomplete="email" inputmode="email" required aria-describedby="error-email" aria-invalid="@(errorEmail is null ? null : "true")">
                    <p class="error-campo" id="error-email">@errorEmail</p>
                </div>
                <div class="campo">
                    <label for="contrasena">Contraseña</label>
                    <div class="con-boton">
                        <input asp-for="Password" type="password" id="contrasena" autocomplete="current-password" required aria-describedby="error-contrasena" aria-invalid="@(errorPassword is null ? null : "true")">
                        <button type="button" class="boton-texto" data-mostrar="contrasena" aria-pressed="false">Mostrar<span class="visualmente-oculto"> contraseña</span></button>
                    </div>
                    <p class="error-campo" id="error-contrasena">@errorPassword</p>
                </div>
                <div class="fila">
                    <label class="check"><input asp-for="Recordarme"> Recordarme en este dispositivo</label>
                    <a href="#" id="olvide">¿Olvidaste tu contraseña?</a>
                </div>
                <p id="nota-olvide" class="texto-suave" role="status"></p>
                <button type="submit" class="boton">Iniciar sesión</button>
            </form>
            <p class="alternativa">¿Todavía no tenés cuenta? <a asp-action="Registro" id="enlace-registro">Creá una</a></p>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
}
